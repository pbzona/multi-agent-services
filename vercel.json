{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "devCommand": "pnpm run dev:app",
      "bindings": [
        {
          "type": "service",
          "service": "commerce",
          "format": "url",
          "env": "COMMERCE_URL"
        }
      ]
    },
    "eve-customer": {
      "root": "apps/customer-agent",
      "framework": "eve",
      "devCommand": "pnpm run dev:app",
      "buildCommand": "EVE_PUBLIC_ROUTE_PREFIX=/eve/agents/customer pnpm run build",
      "bindings": [
        {
          "type": "service",
          "service": "commerce",
          "format": "url",
          "env": "COMMERCE_URL"
        }
      ],
      "routes": [
        {
          "src": "^/eve/agents/customer/eve/v1/(.*)$",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/eve/v1/$1"
            }
          ]
        }
      ]
    },
    "eve-admin": {
      "root": "apps/admin-agent",
      "framework": "eve",
      "devCommand": "pnpm run dev:app",
      "buildCommand": "EVE_PUBLIC_ROUTE_PREFIX=/eve/agents/admin pnpm run build",
      "bindings": [
        {
          "type": "service",
          "service": "commerce",
          "format": "url",
          "env": "COMMERCE_URL"
        }
      ],
      "routes": [
        {
          "src": "^/eve/agents/admin/eve/v1/(.*)$",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/eve/v1/$1"
            }
          ]
        }
      ]
    },
    "commerce": {
      "root": "apps/commerce",
      "framework": "nitro",
      "devCommand": "pnpm run dev:app"
    }
  },
  "rewrites": [
    {
      "source": "/eve/agents/customer/eve/v1/(.*)",
      "destination": { "service": "eve-customer" }
    },
    {
      "source": "/eve/agents/admin/eve/v1/(.*)",
      "destination": { "service": "eve-admin" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
